# clangd 用 compile_commands 的 -I/-D，但过滤 Keil ARMCC 专用参数（否则整文件报红）
CompileFlags:
  CompilationDatabase: ../Lwip_nosys_eied/build/build_template
  Add:
    - -std=c11
    - --target=thumbv7em-none-eabi
  Remove:
    - -c
    - --apcs=*
    - --cpu*
    - --li
    - --c99
    - --split_sections
    - --diag_suppress=*
    - --no_depend_system_headers
    - --depend*
    - -O*
    - -g
    - -o*

Diagnostics:
  Suppress: '*'
